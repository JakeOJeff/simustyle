# Copy to .env locally, then provide credentials through your own environment.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Cheap model for every task. AI_MODEL is the older single-model name, used when AI_MODEL_LUNA is empty.
AI_MODEL_LUNA=gpt-6-luna
AI_MODEL=
# Strong model, used only for scene reviews and the reference step before follow-up builds, and only when AI_SOL_ENABLED=true.
AI_MODEL_SOL=gpt-6-sol
AI_SOL_ENABLED=false
# Visual inspection: renders each finished build whole from four corners and above, and chunk by chunk from all six
# faces, has a vision model score each, and fixes and re-checks what fails (task scene_critique, up to 4 rounds).
# AI_MODEL_VISION defaults to AI_MODEL_SOL.
AI_MODEL_VISION=
AI_CRITIQUE_ENABLED=false
# Reference images: a complex request (complexity 5+ of 10, rated by scene_concept) is first drawn as a concept image
# (scene_image) that the vision model reads into a build spec (scene_reference); the inspection compares against it.
AI_REFERENCE_IMAGE_ENABLED=false
# Image model and quality (low, medium, high) for reference images.
AI_MODEL_IMAGE=gpt-image-2.5-sunburst
AI_IMAGE_QUALITY=high
# Credits per visitor per UTC day (1 credit = $0.00167), and the site's monthly and per-day spending caps in USD.
AI_DAILY_CREDITS=30
AI_MONTHLY_BUDGET_USD=150
AI_DAILY_MAX_USD=15
# Optional: "true"/"false" forces prompt_cache_key on/off (default: on for api.openai.com only).
AI_PROMPT_CACHE_KEY=
# Optional: enables GET /api/ai/spend; send it as the X-Admin-Secret header.
AI_ADMIN_SECRET=
