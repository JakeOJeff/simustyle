{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simustyle",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Built by `npm run build`: landing page at /, editor at /editor/.
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/download/*"]
  },
  "vars": {
    "GITHUB_REPO": "JakeOJeff/simustyle",
    // AI credits per visitor per UTC day; one credit is $0.00167 of provider spend (see src/ai/pricing.ts).
    "AI_DAILY_CREDITS": "30",
    // What the whole site may spend on AI per UTC month, spread over the days left; no day may exceed the max.
    "AI_MONTHLY_BUDGET_USD": "150",
    "AI_DAILY_MAX_USD": "15",
    // Cheap model for every task; the strong one reviews scenes only when AI_SOL_ENABLED is "true".
    "AI_MODEL_LUNA": "gpt-6-luna",
    "AI_MODEL_SOL": "gpt-6-sol",
    "AI_SOL_ENABLED": "true"
  },
  // Holds visitors' daily credits and the month's spend (see AiCreditLedger in worker/index.ts).
  "durable_objects": {
    "bindings": [{ "name": "AI_CREDITS", "class_name": "AiCreditLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiCreditLedger"] }]
  // AI is off until you add the secret AI_API_KEY (`npx wrangler secret put AI_API_KEY`; optionally AI_BASE_URL).
  // Visitors then spend that key, up to the limits above. A secret AI_MODEL is still honoured when AI_MODEL_LUNA is unset.
  // Optional secret AI_ADMIN_SECRET enables GET /api/ai/spend (send it as the X-Admin-Secret header).
  // Optional AI_PROMPT_CACHE_KEY "true"/"false" forces prompt_cache_key on/off (default: on for api.openai.com only).
}
